# --- App ---
APP_NAME=lead-agent
ENVIRONMENT=development        # development | production
LOG_LEVEL=INFO
API_KEY=change-me              # protects your own endpoints

# --- Database ---
# Dev: SQLite. Prod (Render): postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./leads.db

# --- LLM ---
LLM_PROVIDER=gemini            # gemini | openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Scraper ---
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT=LeadAgentBot/1.0

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=